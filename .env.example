# Public browser configuration. Never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Next.js server connection to FastAPI. Do not give it a NEXT_PUBLIC_ prefix.
API_INTERNAL_URL=http://127.0.0.1:8000

# Development service settings. No model key or identity provider is needed.
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
